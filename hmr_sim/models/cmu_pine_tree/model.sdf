<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="cmu_pine_tree">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://cmu_pine_tree/meshes/pine_tree.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="branch">
        <geometry>
          <mesh>
            <uri>model://cmu_pine_tree/meshes/pine_tree.dae</uri>
            <submesh>
              <name>Branch</name>
            </submesh>
          </mesh>
        </geometry>
        <material>
          <double_sided>true</double_sided>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://cmu_pine_tree/materials/textures/branch_2_diffuse.png</albedo_map>
            </metal>
          </pbr>
        </material>
        <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
          <label>3</label>
        </plugin>
      </visual>
      <visual name="bark">
        <geometry>
          <mesh>
            <uri>model://cmu_pine_tree/meshes/pine_tree.dae</uri>
            <submesh>
              <name>Bark</name>
            </submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://cmu_pine_tree/materials/textures/bark_diffuse.png</albedo_map>
            </metal>
          </pbr>
        </material>
        <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
          <label>3</label>
        </plugin>
      </visual>
    </link>
  </model>
</sdf>
