<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="trajectory_camera">
    <static>true</static>
    <link name="camera_link">

      <!-- RGBD camera: matches Husky COSTAR sensor config -->
      <sensor name="rgbd_camera" type="rgbd_camera">
        <topic>rgbd_camera</topic>
        <camera name="rgbd_camera">
          <horizontal_fov>1.0472</horizontal_fov>
          <lens>
            <intrinsics>
              <fx>277.1</fx>
              <fy>277.1</fy>
              <cx>160.5</cx>
              <cy>120.5</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </depth_camera>
          <clip>
            <near>0.01</near>
            <far>300</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
      </sensor>

      <!-- Semantic segmentation camera: same FOV/resolution -->
      <sensor name="segmentation_camera" type="segmentation_camera">
        <topic>segmentation_camera</topic>
        <segmentation_type>semantic</segmentation_type>
        <camera name="segmentation_camera">
          <horizontal_fov>1.0472</horizontal_fov>
          <lens>
            <intrinsics>
              <fx>277.1</fx>
              <fy>277.1</fy>
              <cx>160.5</cx>
              <cy>120.5</cy>
              <s>0</s>
            </intrinsics>
          </lens>
          <image>
            <width>320</width>
            <height>240</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.01</near>
            <far>300</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
      </sensor>

    </link>
  </model>
</sdf>
