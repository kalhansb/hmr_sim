<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="flatforest">
    <scene>
      <grid>false</grid>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.6 0.8 1.0 1</background>
      <shadows>true</shadows>
    </scene>
    <physics name="10ms" type="dart">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <dart>
        <collision_detector>bullet</collision_detector>
        <solver>
          <solver_type>dantzig</solver_type>
        </solver>
      </dart>
    </physics>
    <plugin name="ignition::gazebo::systems::Physics" filename="ignition-gazebo-physics-system" />
    <plugin name="ignition::gazebo::systems::Sensors" filename="ignition-gazebo-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system" />
    <plugin name="ignition::gazebo::systems::UserCommands" filename="ignition-gazebo-user-commands-system" />
    <plugin name="ignition::gazebo::systems::Imu" filename="libignition-gazebo-imu-system.so" />
    <plugin name="hmr_net_sim_system::HMRNetSim" filename="HMRNetSim">
      <!-- Comms topics are now handled by the hmr_comms_relay_node (ROS2 node) -->
      <robot>
        <name>atlas</name>
      </robot>
      <robot>
        <name>bestla</name>
      </robot>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>110 110</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50</mu>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>110 110</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.26 0.13 1</ambient>
            <diffuse>0.4 0.26 0.13 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
          <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
            <label>1</label>
          </plugin>
        </visual>
      </link>
    </model>
    <!-- Sky box commented out — emissive surfaces were flooding scene with light and killing shadows
    <model name="sky_box">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="top">
          <pose>0 0 50 0 0 0</pose>
          <geometry><box><size>200 200 0.1</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.4 0.6 0.85 1</emissive>
            <pbr><metal><albedo_map>model://sky_texture/textures/sky_gradient.png</albedo_map></metal></pbr>
          </material>
        </visual>
        <visual name="north">
          <pose>0 100 0 1.5708 0 0</pose>
          <geometry><box><size>200 100 0.1</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.4 0.6 0.85 1</emissive>
            <pbr><metal><albedo_map>model://sky_texture/textures/sky_gradient.png</albedo_map></metal></pbr>
          </material>
        </visual>
        <visual name="south">
          <pose>0 -100 0 1.5708 0 0</pose>
          <geometry><box><size>200 100 0.1</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.4 0.6 0.85 1</emissive>
            <pbr><metal><albedo_map>model://sky_texture/textures/sky_gradient.png</albedo_map></metal></pbr>
          </material>
        </visual>
        <visual name="east">
          <pose>100 0 0 0 1.5708 0</pose>
          <geometry><box><size>100 200 0.1</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.4 0.6 0.85 1</emissive>
            <pbr><metal><albedo_map>model://sky_texture/textures/sky_gradient.png</albedo_map></metal></pbr>
          </material>
        </visual>
        <visual name="west">
          <pose>-100 0 0 0 1.5708 0</pose>
          <geometry><box><size>100 200 0.1</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.4 0.6 0.85 1</emissive>
            <pbr><metal><albedo_map>model://sky_texture/textures/sky_gradient.png</albedo_map></metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    -->
