<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="flatforest_dense_open">
    <!-- flatforest_dense_open: flatforest_dense_nomaize (sha256 cb7f4bd379253b4e) with the model-level pose of 120
         obstacles changed by make_world.py (115 moved, total 108.9 m, max 2.97 m; 8 turned in yaw), so
         that every gap between two obstacles is clearly open on the near planning map or clearly sealed
         on the far one. Same 270 oaks, 8 pines, 4 stones and 56 walls; no model added or removed. The
         radio world must be regenerated from this file (extract_radio_world.py). -->
    <!-- flatforest_dense with its 48 maize models removed, 2026-10-02
         (generation 39); everything else is byte-identical. The maize had no
         collision since generation 9, but the gpu_lidar renders visuals, so
         the stalks reach the planning map's 0.05-1.0 m band and its halo can
         turn a patch into a wall. All 48 stood in x -26..-17, y -42..-35, the
         SW pocket of the nav-trap reports. flatforest_dense stays as it was
         for the campaigns that ran on it. -->
    <scene>
      <grid>false</grid>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.6 0.8 1.0 1</background>
      <!-- false since 2026-09-15 (generation 9). Ambient is 1 1 1, i.e. fully
           lit from every direction, so the shadow pass darkened patches of a
           scene that has no directional light story to tell; it cost render
           time in the gpu_lidar and segmentation passes and bought nothing any
           consumer reads. The lidar is a depth sensor and never saw them at
           all. -->
      <shadows>false</shadows>
    </scene>
    <!-- 20 ms step / RTF 2 (was 10 ms / RTF 1, 2026-09-04).
         BEHAVIOURAL: halving the physics rate changes contact resolution, so
         wheel slip, tipping and trunk collisions all resolve differently. Runs
         on this world are NOT poolable with anything recorded before this date.
         real_time_factor is a CEILING, not a promise. gz-sim uses it only as
         step_size / rtf to set the update period; the wall-clock budget on this
         box measured ~1.149 s per sim-second (RTF ~0.87) at 10 ms, i.e. already
         CPU-bound below 1. Raising the ceiling to 2 removes the throttle; what
         is actually achieved is whatever the slowest of physics, the canopy
         lidar render and scovox allows.
         KNOWN COST: a 20 ms step is a 50 Hz sensor ceiling. The gpu_lidar at
         10 Hz is unaffected; the IMU (100 Hz) and the two 100 Hz
         odom_publish_frequency diff-drive outputs are halved to 50 Hz.
         real_time_update_rate below is a Gazebo-classic key that gz-sim does
         not read; it is kept consistent with the pair above rather than
         relied on. -->
    <physics name="20ms" type="dart">
      <max_step_size>0.02</max_step_size>
      <real_time_factor>2.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
      <dart>
        <collision_detector>bullet</collision_detector>
        <solver>
          <solver_type>dantzig</solver_type>
        </solver>
      </dart>
    </physics>
    <plugin name="ignition::gazebo::systems::Physics" filename="ignition-gazebo-physics-system" />
    <plugin name="ignition::gazebo::systems::Sensors" filename="ignition-gazebo-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system" />
    <plugin name="ignition::gazebo::systems::UserCommands" filename="ignition-gazebo-user-commands-system" />
    <plugin name="ignition::gazebo::systems::Imu" filename="libignition-gazebo-imu-system.so" />
    <!-- REMOVED 2026-09-15 (generation 9): the hmr_net_sim_system::HMRNetSim
         plugin block, which named atlas and bestla.
         WHY, precisely: NOT because it fails to load. libHMRNetSim.so is built
         and installed (install/hmr_sim/lib/hmr_sim/libHMRNetSim.so) and gz
         loads it without error. It is removed because it is dead weight. It is
         the pre-port comms model, superseded by hmr_comms_sim_node.cpp, a ROS 2
         node the harness launches; it writes nothing to the ECM (verified: zero
         SetComponentData / Create / Remove calls in src/HMRNetSim.cc), so it
         cannot affect physics or any sensor; and it only advertises gz topics
         under /robot_hmr_net_sim/. The single node that ever read those,
         hmr_comms_relay_node, is launched by nothing in this workspace.
         So it spent PostUpdate CPU every physics step computing distances and
         trees-on-link for a pair no consumer reads.
         MEASURED noise, in a cmu_forest_nb cell whose copy of this block had no
         robot children (ts1d_n4 / mtare_rendezvous_r40_ttl0_seed4): 6809 of
         that run's 7921 gz log lines, 86 percent of a 1.1 MB log, were this
         plugin's "Not enough robots" Dbg line. In THIS world the block did name
         two robots, so here it did the arithmetic rather than skipping it.
         Removal is behaviourally inert for the experiment and strictly cheaper.
         The live radio model, and the robot list that actually governs it, is
         config/comms_sim_params.yaml. -->
    <!-- A7 2026-09-15 (generation 9), applied across this file:
         (a) 48 duplicate <pose> children removed from <inertial> blocks. SDF
             takes the first and silently ignores the rest, so the second value
             was never the inertial origin anyone reading this file would think
             it was.
         (b) 50 models carried <static>false</static> and are now static. They
             are maize stalks and boulders: scene decoration that no arm reads
             and that nothing is supposed to push. Dynamic meant every one of
             them was integrated, collision-checked and woken every step.
         (c) 48 maize <collision> blocks removed. A 0.02 x 0.02 x 0.40 m stalk
             is not an obstacle to a Husky, and its collision box topped out at
             0.40 m, exactly the bottom edge of the 0.40-1.00 m band
             simple_nav_3d reads, so it could flicker in and out of the costmap
             on nothing. Stone collisions are KEPT: a 157 kg,
             1 x 0.64 x 0.33 m boulder should stop a robot. -->
    <!-- Tree collision geometry is the FULL oak_tree.dae mesh, canopy included,
         and it is deliberately left that way. The 2026-09-13 setup review
         flagged this as the leading wall-time cost on the grounds that each oak
         carries a ~76k-triangle collision. Measured from the cached mesh, it is
         948 primitives / 812 vertices per tree: 76k is the TOTAL over the 80
         trees of the sparse world, read as if it were per-tree. This world has
         270 oaks, all pointing at that same mesh with no scale override, so
         ~256k collision triangles in total and ~948 per static BVH. That is not
         the bottleneck, and swapping in trunk cylinders would have changed every
         contact in the world to buy nothing. Facts worth keeping from the
         measurement: the trunk is ~0.30-0.55 m in radius across the 0.40-1.00 m
         band simple_nav_3d reads (comms_sim_params.yaml's tree_radius_m of 0.3
         is the low end of that, not a mismatch), and the mesh has a root flare
         reaching ~1.7 m at ground level which no consumer looks at. -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>110 110</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50</mu>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>110 110</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.26 0.13 1</ambient>
            <diffuse>0.4 0.26 0.13 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
          <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
            <label>1</label>
          </plugin>
        </visual>
      </link>
    </model>
    <!-- Sky box commented out — emissive surfaces were flooding scene with light and killing shadows
    <model name="sky_box">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="top">
          <pose>0 0 50 0 0 0</pose>
          <geometry><box><size>200 200 0.1</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.4 0.6 0.85 1</emissive>
            <pbr><metal><albedo_map>model://sky_texture/textures/sky_gradient.png</albedo_map></metal></pbr>
          </material>
        </visual>
        <visual name="north">
          <pose>0 100 0 1.5708 0 0</pose>
          <geometry><box><size>200 100 0.1</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.4 0.6 0.85 1</emissive>
            <pbr><metal><albedo_map>model://sky_texture/textures/sky_gradient.png</albedo_map></metal></pbr>
          </material>
        </visual>
        <visual name="south">
          <pose>0 -100 0 1.5708 0 0</pose>
          <geometry><box><size>200 100 0.1</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.4 0.6 0.85 1</emissive>
            <pbr><metal><albedo_map>model://sky_texture/textures/sky_gradient.png</albedo_map></metal></pbr>
          </material>
        </visual>
        <visual name="east">
          <pose>100 0 0 0 1.5708 0</pose>
          <geometry><box><size>100 200 0.1</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.4 0.6 0.85 1</emissive>
            <pbr><metal><albedo_map>model://sky_texture/textures/sky_gradient.png</albedo_map></metal></pbr>
          </material>
        </visual>
        <visual name="west">
          <pose>-100 0 0 0 1.5708 0</pose>
          <geometry><box><size>100 200 0.1</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.4 0.6 0.85 1</emissive>
            <pbr><metal><albedo_map>model://sky_texture/textures/sky_gradient.png</albedo_map></metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    -->
