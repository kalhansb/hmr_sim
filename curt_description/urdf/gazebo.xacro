<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Some properties -->
  <xacro:include filename="properties.xacro" />

  <!-- Body — dark green painted metal (chassis merges here via fixed joint reduction) -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.05 0.18 0.06 1</ambient>
        <diffuse>0.06 0.22 0.08 1</diffuse>
        <specular>0.8 0.8 0.8 1</specular>
      </material>
    </visual>
  </gazebo>

  <!-- chassis merges into base_link (fixed joint reduction), so no separate override needed -->

  <!-- Wheels — rubber tire (matte black, minimal reflection) -->
  <xacro:macro name="wheel_gazebo" params="link_name">
    <gazebo reference="${link_name}">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>1</mu2>
              <slip1>0.0</slip1>
              <slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_gazebo link_name="front_left_wheel" />
  <xacro:wheel_gazebo link_name="front_right_wheel" />
  <xacro:wheel_gazebo link_name="back_left_wheel" />
  <xacro:wheel_gazebo link_name="back_right_wheel" />

  <!-- IMU -->
  <gazebo reference="imu_link">
    <sensor name="br_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="bytes_imu" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>imu</namespace>
          <remapping>~/out:=data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>true</publish_link_pose>
      <update_frequency>20</update_frequency>
    </plugin>
  </gazebo>

  <!-- Ignition DiffDrive (adapted from COSTAR Husky config) -->
  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_motor</left_joint>
      <left_joint>back_left_motor</left_joint>
      <right_joint>front_right_motor</right_joint>
      <right_joint>back_right_motor</right_joint>
      <wheel_separation>0.516</wheel_separation>
      <wheel_radius>0.13</wheel_radius>
      <odom_publish_frequency>10</odom_publish_frequency>
      <topic>/curt/cmd_vel</topic>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
      <max_linear_velocity>1.0</max_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
    </plugin>
  </gazebo>

  <!-- wheel_gazebo macro already includes Husky-style friction — no duplicate needed -->

</robot>